{
  "name": "@rent/web",
  "version": "1.0.0",
  "description": "Rent-a-car website, admin panel and public API",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3050",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "seed:legal": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-legal-pages.ts",
    "seed:faqs": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-faqs.ts",
    "seed:vehicle-texts": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-vehicle-descriptions.ts",
    "rebase-currency": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/rebase-currency.ts",
    "vehicle-photos": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/import-vehicle-photos.ts",
    "company-profile": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/apply-company-profile.ts",
    "demo:setup": "sh ./scripts/demo-setup.sh",
    "demo-user": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/create-demo-user.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@lexical/list": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@rent/shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lexical": "0.50.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "private": true
}
