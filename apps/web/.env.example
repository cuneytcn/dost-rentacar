DATABASE_URL=postgres://rent:rent@localhost:5433/rent
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3050
# Cloudflare Turnstile (optional in development; captcha is skipped when empty)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Search engine ownership verification (meta tags); from Google Search Console / Yandex Webmaster
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Email over SMTP (Resend, Brevo, …). Emails are printed to the console when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Dost Rent a Car

# SMS provider driver (only "console" until a provider is chosen)
SMS_PROVIDER=console

# Exchange rates: licensed XE Currency Data API (xecdapi.xe.com). Refresh is skipped when empty.
XE_ACCOUNT_ID=
XE_API_KEY=

# Set to false on instances that must not process background jobs
JOBS_AUTORUN=true
